{
  "id":"com.securehub:securehub.all:slingosgifeature:1.0.0-SNAPSHOT",
  "bundles":[
    {
      "id":"com.securehub:securehub.core:1.0.0-SNAPSHOT",
      "Bundle-SymbolicName":"securehub.core",
      "Bundle-Version":"1.0.0.SNAPSHOT",
      "start-order":"20",
      "content-package-origins":"com.securehub:securehub.all:1.0.0-SNAPSHOT"
    }
  ],
  "configurations":  {
    "com.adobe.cq.wcm.core.components.internal.servlets.TableOfContentsFilter~securehub":    {
      "enabled":"true",
      ":configurator:content-package-origins":"com.securehub:securehub.all:1.0.0-SNAPSHOT|com.securehub:securehub.ui.config:1.0.0-SNAPSHOT"
    },
    "org.apache.sling.commons.log.LogManager.factory.config~securehub":    {
      "org.apache.sling.commons.log.names":[
        "com.securehub"
      ],
      "org.apache.sling.commons.log.level":"INFO",
      "org.apache.sling.commons.log.file":"logs/error.log",
      "org.apache.sling.commons.log.additiv":"false",
      ":configurator:content-package-origins":"com.securehub:securehub.all:1.0.0-SNAPSHOT|com.securehub:securehub.ui.config:1.0.0-SNAPSHOT"
    }
  },
  "content-packages:ARTIFACTS|true":[
    "com.securehub:securehub.ui.apps:zip:cp2fm-converted:1.0.0-SNAPSHOT",
    "com.securehub:securehub.ui.config:zip:cp2fm-converted:1.0.0-SNAPSHOT",
    "com.securehub:securehub.all:zip:cp2fm-converted:1.0.0-SNAPSHOT"
  ],
  "repoinit:TEXT|true":[
    "# origin=com.securehub:securehub.all:1.0.0-SNAPSHOT|com.securehub:securehub.ui.config:1.0.0-SNAPSHOT source=org.apache.sling.jcr.repoinit.RepositoryInitializer~securehub\r",
    "create path (sling:OrderedFolder) /content/dam/securehub\r",
    "create path (nt:unstructured) /content/dam/securehub/jcr:content\r",
    "set properties on /content/dam/securehub/jcr:content",
    "  set cq:conf{String} to /conf/securehub",
    "  set jcr:title{String} to \"SecureHub Employee Security Portal\"",
    "end"
  ],
  "oak-index-definitions:JSON|false":{
    "/oak:index/diff.index":{
      "jcr:primaryType":"nam:nt:unstructured",
      "type":"lucene",
      "includedPaths":"/same",
      "queryPaths":"/same",
      "async":"async",
      "diff.json":{
        "jcr:primaryType":"nam:nt:file",
        "jcr:content":{
          "jcr:primaryType":"nam:nt:resource",
          "jcr:mimeType":"application/json",
          "jcr:data":":blobId:ew0KfQ0K"
        }
      }
    }
  },
  "api-regions:JSON|false":[
    {
      "name":"global",
      "exports":[
        "com.securehub.core.filters",
        "com.securehub.core.listeners",
        "com.securehub.core.models",
        "com.securehub.core.schedulers",
        "com.securehub.core.servlets"
      ]
    },
    {
      "name":"com.adobe.aem.deprecated"
    }
  ]
}